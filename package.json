{
  "name": "@kierratysappi/root",
  "version": "0.1.0",
  "private": true,
  "description": "Source-backed Finnish packaging sorting application",
  "license": "UNLICENSED",
  "packageManager": "pnpm@11.16.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": ">=11 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint": "biome lint .",
    "security:audit": "node scripts/audit-policy.mjs",
    "test": "node --test scripts/__tests__/*.test.mjs && pnpm -r --if-present test",
    "test:coverage": "pnpm -r --if-present test:coverage",
    "typecheck": "pnpm -r --if-present typecheck",
    "check:boundaries": "node scripts/check-workspace-boundaries.mjs",
    "dev:mobile": "pnpm --filter @kierratysappi/mobile start",
    "dev:backend": "pnpm --filter @kierratysappi/api dev",
    "validate:mobile": "node scripts/validate-part.mjs mobile",
    "validate:backend": "node scripts/validate-part.mjs backend",
    "validate:shared": "node scripts/validate-part.mjs shared",
    "validate": "pnpm check:boundaries && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.7",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.12",
    "tsup": "8.5.1",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vitest": "4.1.12"
  }
}
