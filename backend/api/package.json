{
  "name": "@kierratysappi/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/server.ts",
  "scripts": {
    "build": "tsup --config tsup.config.ts",
    "dev": "node --env-file-if-exists=.env.local --import tsx --watch src/server.ts",
    "start": "node --env-file-if-exists=.env.local dist/server.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@fastify/cors": "11.4.1",
    "@fastify/helmet": "13.2.0",
    "@fastify/rate-limit": "11.2.2",
    "@fastify/swagger": "9.9.3",
    "@kierratysappi/application": "workspace:*",
    "@kierratysappi/contracts": "workspace:*",
    "@kierratysappi/data-providers": "workspace:*",
    "@kierratysappi/domain": "workspace:*",
    "fastify": "5.12.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "tsx": "4.21.0"
  }
}
