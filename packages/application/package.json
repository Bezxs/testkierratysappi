{
  "name": "@kierratysappi/application",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lookup-schema": "./src/lookup-schema.ts",
    "./collection-points": "./src/collection-points.ts"
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@kierratysappi/data-providers": "workspace:*",
    "@kierratysappi/domain": "workspace:*",
    "@kierratysappi/recycling-engine": "workspace:*",
    "zod": "4.4.3"
  }
}
